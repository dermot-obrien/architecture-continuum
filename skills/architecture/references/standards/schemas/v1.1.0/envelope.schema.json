{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Universal Artefact Envelope (v1.1.0)",
  "description": "Common frontmatter fields carried by every catalog artefact in AI-Assisted Architecture v1.1.0. Per-kind schemas import this via $ref and add their own constraints.",
  "type": "object",
  "$defs": {
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Semantic version (major.minor.patch with optional pre-release)."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "active",
        "deprecated",
        "superseded",
        "retired"
      ]
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "baseline",
        "in-flight",
        "target",
        "retired"
      ],
      "default": "baseline"
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "default": "internal"
    },
    "governanceZone": {
      "type": "string",
      "enum": [
        "foundation",
        "core",
        "extension",
        "application"
      ],
      "default": "application"
    },
    "kindEnum": {
      "type": "string",
      "enum": [
        "outcome",
        "use-case",
        "platform",
        "product",
        "capability",
        "bounded-context",
        "abb",
        "sbb",
        "pattern",
        "api",
        "service",
        "view",
        "decision-record",
        "event",
        "deployment-node",
        "consideration",
        "technical-debt",
        "landscape",
        "feature",
        "store",
        "candidate"
      ]
    },
    "anyId": {
      "description": "Any valid artefact ID. Per-kind ID patterns: OC|UC|LS|PL|PRD|FE|CAP|BC|ABB|SBB|AP|RA|CL|API|SV|VW|DR|ADR|EV|DN|ST|CN|TD followed by '-NNN' (3-digit zero-padded), OR a kebab-case slug for Service kind.",
      "type": "string",
      "pattern": "^(OC|UC|LS|PL|PRD|FE|CAP|BC|ABB|SBB|AP|RA|CL|API|SV|VW|A?DR|EV|DN|ST|CN|TD)-\\d{3}$|^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "platformId": {
      "type": "string",
      "pattern": "^PL-\\d{3}$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^CAP-\\d{3}$"
    },
    "outcomeId": {
      "type": "string",
      "pattern": "^OC-\\d{3}$"
    },
    "useCaseId": {
      "type": "string",
      "pattern": "^UC-\\d{3}$"
    },
    "landscapeId": {
      "type": "string",
      "pattern": "^LS-\\d{3}$",
      "description": "A platform landscape: LS-NNN, the layers of platforms an enterprise runs and the dependencies between them."
    },
    "layerId": {
      "type": "string",
      "pattern": "^L\\d+$",
      "description": "A layer of a platform landscape: L0 at the bottom, numbered upwards. Declared on the landscape, not a kind of its own."
    },
    "productId": {
      "type": "string",
      "pattern": "^PRD-\\d{3}$",
      "description": "A product: PRD-NNN, a consumable offering of one platform."
    },
    "featureId": {
      "type": "string",
      "pattern": "^FE-\\d{3}$",
      "description": "A feature of a product: FE-NNN. Usually a row of the product's register; a feature may also have a page of its own, with kind feature."
    },
    "bcId": {
      "type": "string",
      "pattern": "^BC-\\d{3}$"
    },
    "abbId": {
      "type": "string",
      "pattern": "^ABB-\\d{3}$"
    },
    "sbbId": {
      "type": "string",
      "pattern": "^SBB-\\d{3}$"
    },
    "apiId": {
      "type": "string",
      "pattern": "^API-\\d{3}$",
      "description": "An API: API-NNN. The series was AP-NNN until the two kinds of pattern document took AP and RA."
    },
    "architecturePatternId": {
      "type": "string",
      "pattern": "^AP-\\d{3}$",
      "description": "An architecture pattern: technology-agnostic, conceptual or logical."
    },
    "referenceArchitectureId": {
      "type": "string",
      "pattern": "^RA-\\d{3}$",
      "description": "A reference architecture: technology-specific, physical; applies architecture patterns."
    },
    "collaborationId": {
      "type": "string",
      "pattern": "^CL-\\d{3}$",
      "description": "A collaboration: participants working together, with lighter rules than an architecture pattern; its boxes need not be catalogued building blocks."
    },
    "viewId": {
      "type": "string",
      "pattern": "^VW-\\d{3}$"
    },
    "drId": {
      "type": "string",
      "pattern": "^A?DR-\\d{3}$",
      "description": "A decision record: DR-NNN, or ADR-NNN where a repository keeps the ADR series."
    },
    "eventId": {
      "type": "string",
      "pattern": "^EV-\\d{3}$"
    },
    "dnId": {
      "type": "string",
      "pattern": "^DN-\\d{3}$"
    },
    "storeId": {
      "type": "string",
      "pattern": "^ST-\\d{3}$",
      "description": "A store: ST-NNN, a database, bucket, table, index or secret owned by one bounded context. A resource of a service, not a service."
    },
    "considerationId": {
      "type": "string",
      "pattern": "^CN-\\d{3}$"
    },
    "technicalDebtId": {
      "type": "string",
      "pattern": "^TD-\\d{3}$",
      "description": "A technical debt item: TD-NNN, a shortfall knowingly or unknowingly taken on, a consequence of a decision."
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Kebab-case slug for Service kind (preserves v1.0.0 convention)."
    },
    "numericServiceId": {
      "type": "string",
      "pattern": "^SV-\\d{3}$"
    },
    "reference": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "jira",
            "linear",
            "github-pr",
            "github-issue",
            "source",
            "doc",
            "runbook",
            "external",
            "evidence",
            "cost-model"
          ],
          "description": "evidence: an experiment, build or evaluation showing the artefact meets its criteria (definition-ladder R5). cost-model: the model of the running cost (R4). runbook: how it is operated (R6)."
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Agent-native AI-authorship lineage (optional). See standards/agent-native/provenance.md. Records how an artefact was produced and verified. Backward-compatible: absent on v1.0.0/v1.1.0 artefacts that predate it.",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "ai-generated",
            "ai-edited",
            "human-authored",
            "human-edited"
          ]
        },
        "authored_by": {
          "type": "string",
          "description": "Model/agent identifier or person."
        },
        "authored_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_ref": {
          "type": "string",
          "description": "Work item / inquiry / prompt that triggered it."
        },
        "prompt_digest": {
          "type": "string",
          "description": "Hash of the driving instruction (auditable, not raw text)."
        },
        "review_state": {
          "type": "string",
          "enum": [
            "ai-raw",
            "ai-verified",
            "human-reviewed",
            "human-approved"
          ]
        },
        "verified_by": {
          "type": "array",
          "description": "Adversarial verifier records (operating-model.md verify stage).",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "supersedes_provenance": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "origin",
        "review_state"
      ],
      "additionalProperties": false
    },
    "universalRelations": {
      "type": "object",
      "description": "Universal relations subset. Per-kind schemas may make specific fields required and add their own specialised relations.",
      "properties": {
        "part_of": {
          "$ref": "#/$defs/anyId"
        },
        "contains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        },
        "realises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        },
        "realised_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        },
        "depended_on_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        },
        "applies_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        },
        "governed_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyId"
          },
          "uniqueItems": true
        }
      }
    },
    "portfolioState": {
      "type": "string",
      "enum": [
        "placeholder",
        "draft",
        "needs-conversion",
        "proposed-deprecation",
        "archive",
        "archived"
      ],
      "description": "What the portfolio is doing about the document. placeholder: committed, with no content yet. draft: an AI-generated draft from research, awaiting review. needs-conversion: not in the form its type expects. proposed-deprecation: may be retired, awaiting agreement. archive: deprecation agreed, to be moved to the archive. archived: moved there. Absent: live, nothing pending."
    },
    "portfolio": {
      "type": "object",
      "description": "The portfolio block (§2.9): the document's standing in the repository's portfolio of patterns. Optional on a pattern, a use case and a candidate.",
      "properties": {
        "state": {
          "$ref": "#/$defs/portfolioState"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "target_quarter": {
          "type": "string",
          "pattern": "^\\d{4}-Q[1-4]$",
          "description": "The quarter the document is meant to be ready, YYYY-Qn."
        },
        "committed": {
          "type": "boolean",
          "description": "Whether the document is committed work rather than a possibility."
        },
        "reason": {
          "type": "string",
          "description": "Why the state was set."
        },
        "since": {
          "$ref": "#/$defs/isoDate",
          "description": "When the state was set."
        },
        "backlog_ref": {
          "type": "string",
          "description": "The backlog row or ticket the document came from."
        },
        "archived_from": {
          "type": "string",
          "description": "Where an archived document lived before it was archived, relative to the repository root."
        }
      },
      "additionalProperties": false
    },
    "banner": {
      "type": "object",
      "description": "A notice a site shows at the top of the page, such as the warning on an AI-generated draft.",
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "info",
            "note",
            "warning",
            "danger"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/anyId"
    },
    "kind": {
      "$ref": "#/$defs/kindEnum"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "created": {
      "$ref": "#/$defs/isoDate"
    },
    "last_modified": {
      "$ref": "#/$defs/isoDate"
    },
    "last_modified_by": {
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/lifecycleState"
    },
    "valid_from": {
      "$ref": "#/$defs/isoDate"
    },
    "valid_until": {
      "anyOf": [
        {
          "$ref": "#/$defs/isoDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anyId"
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anyId"
      },
      "uniqueItems": true
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "strategic_owner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "governance_zone": {
      "$ref": "#/$defs/governanceZone"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "portfolio": {
      "$ref": "#/$defs/portfolio"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sidebar_label": {
      "type": "string"
    },
    "sidebar_position": {
      "type": "integer"
    },
    "unlisted": {
      "type": "boolean",
      "description": "Site presentation: when true, the page is built but kept out of the sidebar, the search index and the sitemap (Docusaurus unlisted). For pages kept for the record rather than for reading."
    },
    "moved_to": {
      "type": "string",
      "description": "Site presentation: on a stub left where an archived page was, the page's new place, relative to the stub. A stub carries no kind and is not an artefact."
    },
    "deck_publish": {
      "type": "boolean",
      "description": "Site presentation: markdown-deck publishes the page as a deck."
    },
    "deck_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Site presentation: the deck's identifier, the folder it publishes to."
    },
    "banner": {
      "$ref": "#/$defs/banner"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "version",
    "status",
    "created",
    "last_modified",
    "owner"
  ],
  "allOf": [
    {
      "$comment": "If status is 'superseded', superseded_by must be present and non-empty.",
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "required": [
          "superseded_by"
        ],
        "properties": {
          "superseded_by": {
            "minItems": 1
          }
        }
      }
    },
    {
      "$comment": "If valid_until is set, it must be on or after valid_from.",
      "if": {
        "required": [
          "valid_from",
          "valid_until"
        ],
        "properties": {
          "valid_until": {
            "type": "string"
          }
        }
      },
      "then": {
        "$comment": "Date ordering not expressible in pure JSON Schema; enforced by the validator script."
      }
    }
  ]
}
