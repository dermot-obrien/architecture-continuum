<mxfile host="app.diagrams.net" agent="architecture-continuum" compressed="false">
  <diagram id="landscape" name="The skill bundles">
    <mxGraphModel dx="1746" dy="917" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
