        <mxCell id="band-L1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=5;fillColor=#EEF2FB" value="&lt;b&gt;L1 METHOD&lt;/b&gt;" vertex="1">
