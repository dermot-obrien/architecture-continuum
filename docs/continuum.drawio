        <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;The continuum: from the platform landscape to a deployable unit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5a6a86&quot;&gt;Demand space says who owns what and what must be possible. Solution space says how it is structured and built. Runtime says what runs where.&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="1200" x="24" y="3" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EEF2FB;arcSize=5;" value="DEMAND SPACE" vertex="1">
